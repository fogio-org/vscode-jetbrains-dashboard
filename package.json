{
  "name": "jetbrains-dashboard",
  "displayName": "JetBrains Dashboard",
  "description": "JetBrains-style Welcome Screen for VS Code",
  "version": "0.1.0",
  "publisher": "fogio",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fogio-org/vscode-jetbrains-dashboard"
  },
  "bugs": {
    "url": "https://github.com/fogio-org/vscode-jetbrains-dashboard/issues"
  },
  "homepage": "https://github.com/fogio-org/vscode-jetbrains-dashboard#readme",
  "galleryBanner": {
    "color": "#1E1F22",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["jetbrains", "dashboard", "welcome", "start screen", "project manager"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "fogioDashboard.open",
        "title": "JetBrains Dashboard: Open"
      },
      {
        "command": "fogioDashboard.pinProject",
        "title": "JetBrains Dashboard: Pin Project"
      },
      {
        "command": "fogioDashboard.addProject",
        "title": "JetBrains Dashboard: Add Project to List"
      },
      {
        "command": "fogioDashboard.clearHistory",
        "title": "JetBrains Dashboard: Clear Project History"
      }
    ],
    "configuration": {
      "title": "JetBrains Dashboard",
      "properties": {
        "fogioDashboard.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show dashboard on startup when no folder is open."
        },
        "fogioDashboard.projectsSource": {
          "type": "string",
          "enum": ["recentlyOpened", "manual", "both"],
          "enumDescriptions": [
            "Use VS Code's recently opened history",
            "Use manually added projects only",
            "Combine recently opened and manually added projects"
          ],
          "default": "recentlyOpened",
          "description": "Source of project list."
        },
        "fogioDashboard.maxProjects": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of projects to display."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "lint": "npx tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
